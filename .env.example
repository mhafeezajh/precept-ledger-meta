# Copy to .env and fill in. .env is git-ignored. Never commit real keys or passwords.

# Postgres URL for the app role. The role has INSERT + SELECT on ledger tables only.
DATABASE_URL=postgresql://pl_app:change-me@localhost:5432/precept_ledger

# Directory OUTSIDE the repo with private keys (gate-1.pem, log.pem) and trusted.json (public
# keys). Create with: uv run python scripts/dev_keys.py. Never committed.
KEYS_DIR=/path/outside/repo/keys

# Superuser URL. Used ONLY by integration tests and the demo tamper button (DEMO_MODE=true).
ADMIN_DATABASE_URL=postgresql://postgres:change-me-superuser@localhost:5432/precept_ledger

# Default ledger stream for the demo bank.
LEDGER_STREAM=harbor-federal/decisions

# Checkpoint origin prefix; each stream's origin is <LEDGER_ORIGIN>/<stream> (C2SP tlog-checkpoint).
LEDGER_ORIGIN=precept-ledger.local

# Write-once directory for signed checkpoints, one file per tree size. Git-ignored.
CHECKPOINT_DIR=var/checkpoints

# Seconds between checkpoints (ARCHITECTURE flow D).
CHECKPOINT_INTERVAL_SECONDS=10

# Ledger API bind address. Keep 127.0.0.1: reads are unauthenticated in the demo.
API_HOST=127.0.0.1
API_PORT=8080
LOG_LEVEL=INFO

# Witnesses the ledger sends each checkpoint to, as name=url pairs. Empty: no witnessing.
# Their cosigner keys come from $KEYS_DIR/witnesses.txt (also pl-verify --witness-keys).
WITNESSES=witness-1=http://127.0.0.1:8091,witness-2=http://127.0.0.1:8092,witness-3=http://127.0.0.1:8093
# Cosignatures a checkpoint needs to be final (D5: 2 of 3).
WITNESS_QUORUM=2
WITNESS_TIMEOUT_SECONDS=5

# Anchors (anchor/, ledger/anchoring.py). RFC 3161 TSAs as name=url pairs; every final
# checkpoint is timestamped by each. Empty: no timestamps. Tokens are checked against
# TSA_ROOTS_FILE (public root certificates, see deploy/tsa/README.md) before they are stored.
TSAS=digicert=http://timestamp.digicert.com,freetsa=https://freetsa.org/tsr
TSA_ROOTS_FILE=deploy/tsa/roots.pem
# OpenTimestamps: calendars to submit the latest final checkpoint to, once per interval, and
# the only calendars pending proofs are ever upgraded from. Empty OTS_CALENDARS: no Bitcoin.
OTS_CALENDARS=https://a.pool.opentimestamps.org,https://b.pool.opentimestamps.org
OTS_UPGRADE_CALENDARS=https://alice.btc.calendar.opentimestamps.org,https://bob.btc.calendar.opentimestamps.org
OTS_INTERVAL_SECONDS=3600
ANCHOR_TIMEOUT_SECONDS=10

# Each witness process (pl-witness) reads WITNESS_* variables; `make witnesses` sets them per
# witness. Listed here for reference. Never point WITNESS_STATE_DIR at the ledger's storage.
# WITNESS_NAME=witness-1
# WITNESS_KEY_FILE=/path/outside/repo/keys/witnesses/witness-1.pem
# WITNESS_LOGS_FILE=/path/outside/repo/keys/log-verifiers.txt
# WITNESS_STATE_DIR=var/witness-1
# WITNESS_HOST=127.0.0.1
# WITNESS_PORT=8091

# Gate (pl-gate, `make gate`). Reads KEYS_DIR/gate-1.pem, trusted.json and gate-callers.txt
# (token hashes; the tokens themselves are in KEYS_DIR/tokens/, made by scripts/dev_keys.py).
GATE_LEDGER_URL=http://127.0.0.1:8080
# The active Cedar policy set, validated against gate/schema.cedarschema at start.
GATE_POLICY_FILE=deploy/policies/harbor-federal.cedar
# Payees the bank has paid before; anyone else is payee_new.
GATE_PAYEES_FILE=deploy/demo/payees.json
# Email domains that count as internal (comm.external.external_recipients).
GATE_INTERNAL_DOMAINS=harborfederal.example
# local_hour and local_weekday facts are in this time zone (the bank's business hours).
GATE_TIMEZONE=America/New_York
# An escalation with no verdict by then is denied.
GATE_APPROVAL_TIMEOUT_SECONDS=900
GATE_SWEEP_INTERVAL_SECONDS=5
GATE_HOST=127.0.0.1
GATE_PORT=8070

# Approval briefs from Muse Spark (assist/brief.py). Off when the active profile has no credentials.
GATE_BRIEFS=true
# D88: deny any call without a principal's issued, unrevoked, in-scope delegation credential,
# checked before Cedar. Principal public keys: KEYS_DIR/principals.json. Off until the agent
# carries a credential.
GATE_REQUIRE_DELEGATION=false

# Models (assist/llm.py, docs/MODELS.md). Standard mode only: never a -contributor model ID.
# cloud = the Meta Model API (needs META_API_KEY); mock = scripted answers, offline, no cost,
# labelled mock/scripted in every record (D72); onprem = an OpenAI-compatible endpoint.
MODEL_PROFILE=cloud
# Meta Model API key. Leave empty to run without briefs. Never commit it.
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1
# MODEL_PROFILE=onprem sends spark calls to this OpenAI-compatible endpoint instead (stretch).
ONPREM_API_BASE=
ONPREM_MODEL=
# Meta's reasoning_effort for cloud calls: minimal, low, medium, high, xhigh or max; empty lets
# the model pick. medium: the learner's proposals pass their checks in about 40 s each.
MODEL_REASONING_EFFORT=medium
# Per model call, never retried on timeout; a live learner call took 110 s at medium effort.
MODEL_TIMEOUT_SECONDS=150
# One row per model call: tokens, latency, outcome, and a hash of the prompt (never the prompt).
MODEL_CALL_LOG=logs/model_calls.csv

# The payments-ops agent (agent/cli.py, pl-agent, make demo-agent). Its token is
# KEYS_DIR/tokens/<AGENT_ID>.token; it verifies Gate's records with KEYS_DIR/trusted.json.
AGENT_ID=payments-ops
AGENT_GATE_URL=http://127.0.0.1:8070
AGENT_GATE_PRODUCER_ID=gate-1
AGENT_VENDORS_FILE=deploy/demo/vendors.json
AGENT_MAX_STEPS=8
AGENT_GATE_TIMEOUT_SECONDS=30
# The principal's signed delegation the agent presents (D89); default KEYS_DIR/credentials/<id>.json,
# written by make delegate. Leave unset to use the default.
# AGENT_CREDENTIAL_FILE=

# The Policy Learner (learn/, served by pl-gate at /learn/v1, make demo-learn). It reads the
# ledger's export from GATE_LEDGER_URL and verifies it with KEYS_DIR/trusted.json first.
# agent=owner pairs: an agent's owner may not approve loosening that agent's rules.
LEARN_AGENT_OWNERS=payments-ops=j.ortiz
# Fatigue filter and minimum sample: approvals under FAST_SECONDS, or by an approver at 100%
# over MIN_SAMPLE verdicts, are set aside; patterns under MIN_SAMPLE decisions are skipped.
LEARN_MIN_SAMPLE=20
LEARN_FAST_SECONDS=5
LEARN_EXPORT_TIMEOUT_SECONDS=30
# Count only records under a checkpoint cosigned by the witness quorum (KEYS_DIR/witnesses.txt).
LEARN_WITNESSED=true

# The two web apps (web/): the Console (pl-web, make web) and the Approvals app (pl-approvals,
# make approvals), D94. They act with the Gate tokens in KEYS_DIR/tokens and
# verify the ledger with KEYS_DIR/trusted.json and witnesses.txt. Localhost only: anyone who
# reaches them can pick any listed person (demo stand-in for sign-in).
WEB_HOST=127.0.0.1
WEB_PORT=8090
WEB_APPROVALS_PORT=8094
WEB_CONSOLE_URL=http://127.0.0.1:8090
WEB_APPROVALS_URL=http://127.0.0.1:8094
WEB_GATE_URL=http://127.0.0.1:8070
WEB_LEDGER_URL=http://127.0.0.1:8080
WEB_TIMEZONE=America/New_York
WEB_TIMEOUT_SECONDS=200
WEB_WITNESSED=true
WEB_SECURE_COOKIE=false
# Empty: a new session key each start. Set one (32+ random bytes) to keep sessions across restarts.
WEB_SESSION_SECRET=

# Enables demo-only features (tamper button, admin connection). Never true outside a demo.
DEMO_MODE=false

# Used only by docker compose to create the database and the app role.
POSTGRES_PASSWORD=change-me-superuser
PL_APP_PASSWORD=change-me
