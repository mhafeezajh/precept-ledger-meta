# Copy to .env and fill in. .env is git-ignored. Never commit real keys or passwords.

# Postgres URL for the app role. The role has INSERT + SELECT on ledger tables only.
DATABASE_URL=postgresql://pl_app:change-me@localhost:5432/precept_ledger

# Directory OUTSIDE the repo with private keys (gate-1.pem, log.pem, ...). Never committed.
KEYS_DIR=/path/outside/repo/keys

# Default ledger stream for the demo bank.
LEDGER_STREAM=harbor-federal/decisions

# Enables demo-only features (tamper button, admin connection). Never true outside a demo.
DEMO_MODE=false

# Used only by docker compose to create the database and the app role.
POSTGRES_PASSWORD=change-me-superuser
PL_APP_PASSWORD=change-me
